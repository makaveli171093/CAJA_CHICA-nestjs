# ==============================================================================
# CONFIGURACIÓN DE VARIABLES DE ENTORNO - CAJA CHICA CPS (FASE 1)
# Copiar este archivo a .env y ajustar las credenciales locales
# ==============================================================================

# Entorno de ejecución: development | production | test
NODE_ENV=development

# Puerto del servidor backend HTTP
PORT=3000

# URL de conexión a PostgreSQL (Base de datos exclusiva para este proyecto)
DATABASE_URL="postgresql://postgres:TU_PASSWORD@localhost:5432/caja_chica_cps?schema=public"

# Clave secreta para firma de JSON Web Tokens (JWT)
JWT_SECRET="CAMBIAR_POR_SECRETO_CRIPTOGRAFICAMENTE_SEGURO_CPS_2026"
JWT_EXPIRES_IN="8h"

# URL autorizada del frontend para CORS y Cookies SameSite
FRONTEND_URL="http://localhost:5173"

# Protección contra ataques de fuerza bruta (Throttler)
THROTTLE_TTL=60
THROTTLE_LIMIT=15

# Documentación Swagger OpenAPI (habilitado sólo en desarrollo)
SWAGGER_ENABLED=true

# Zona horaria oficial del sistema
TIMEZONE="America/La_Paz"
